# Cheile stau DOAR aici. Fișierul .env nu se pune pe GitHub.
YOUTUBE_API_KEY="pune-aici-cheia-youtube"

# AI principal: OpenRouter
OPENROUTER_API_KEY="pune-aici-cheia-openrouter"
# Numele modelului. Serverul caută singur identificatorul exact în lista OpenRouter.
# Poți pune și identificatorul exact copiat de pe https://openrouter.ai/models
OPENROUTER_MODEL="auto"

# Rezervă: Gemini (folosit doar dacă OPENROUTER_API_KEY e gol)
GEMINI_API_KEY="pune-aici-cheia-gemini"
GEMINI_MODEL="gemini-2.5-flash"

PORT=3001
OPENROUTER_IMAGE_MODEL="auto"
